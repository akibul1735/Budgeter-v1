<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_add_transaction"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_1x1_container_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/widget_circle_button_tx_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_receipt"
            android:tint="#FFFFFF"
            android:contentDescription="Quick Add Transaction" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="+ Transaction"
        android:textColor="#34D399"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
