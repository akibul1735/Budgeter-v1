<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_goal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Title & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAVINGS GOAL"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_goal_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Goal Title & Target -->
    <TextView
        android:id="@+id/tv_goal_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Emergency Fund"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Saved vs Target -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_goal_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="৳0"
            android:textColor="#10B981"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_goal_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="/ ৳0"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_goal_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_goal_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <!-- Remaining to Save -->
    <TextView
        android:id="@+id/tv_goal_remaining"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:text="৳0 to go"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:maxLines="1" />

</LinearLayout>
